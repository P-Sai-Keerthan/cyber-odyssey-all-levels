# =============================================================================
# ACN CYBER ODYSSEY — docker compose environment
# =============================================================================
# Copy to `.env`, fill in every value, then start the stack:
#
#     cp .env.example .env
#     docker compose up -d --build
#
# WHY THE NAME MATTERS
# --------------------
# `docker compose` automatically loads a file called `.env` from the directory
# holding docker-compose.yml. Any other name — `.env.docker`, `.env.prod` —
# is only read when you pass it explicitly:
#
#     docker compose --env-file .env.docker up -d
#
# Forgetting that flag is what produces:
#
#     required variable POSTGRES_PASSWORD is missing a value
#     required variable ADMIN_PASSWORD is missing a value
#     required variable SESSION_SECRET is missing a value
#
# The stack is NOT misconfigured when that happens — Compose simply never read
# the file. Name it `.env` and the flag becomes unnecessary.
#
# `.env` is git-ignored. THIS file is committed and must never carry a real
# secret.
#
# Generate any secret below with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# base64url output is URL-safe, which matters: POSTGRES_PASSWORD is interpolated
# into DATABASE_URL. A password containing `@`, `/`, `:` or `#` silently breaks
# that URL and the application fails to connect for reasons that look nothing
# like a bad password.
# =============================================================================

# --- PostgreSQL (shared by both applications) --------------------------------
# One server, two databases: POSTGRES_DB is Level 1's, PORTAL_DB is the Portal's.
# The Portal moved off SQLite because SQLite admits one writer at a time, and
# 100 squads scoring inside the same minutes is a write-concurrency problem it
# cannot solve.
POSTGRES_USER=odyssey
POSTGRES_PASSWORD=            # REQUIRED — no default. Generate one.
POSTGRES_DB=cyber_odyssey
PORTAL_DB=odyssey_portal

# --- Shared integration secret ----------------------------------------------
# ONE value, used by BOTH services. If they differ, every ticket redemption and
# every score callback fails signature verification with a 401 that looks like a
# bug in the bridge.
ODYSSEY_LEVEL1_SECRET=        # REQUIRED — no default. Generate one (48 bytes).

# --- Level 1 -----------------------------------------------------------------
# Signs team AND admin cookies. Minimum 24 characters; Level 1 refuses to issue
# or accept a session without it outside development.
SESSION_SECRET=               # REQUIRED — no default. Generate one (48 bytes).
# Level 1 admin console. There is no default and no fallback anywhere in the
# code — unset means admin sign-in answers 503 rather than accepting a guess.
ADMIN_PASSWORD=               # REQUIRED — no default.

# --- Portal bootstrap creator ------------------------------------------------
# Read ONLY by `npm run db:seed`, never by the running server. Seeding is a
# one-off bootstrap step; see RUNBOOK.md, "Bootstrapping the first creator".
CREATOR_EMAIL=creator@example.org
CREATOR_PASSWORD=             # REQUIRED for seeding only.
CREATOR_USERNAME=event_creator

# --- PUBLIC addresses --------------------------------------------------------
# What a PARTICIPANT'S BROWSER types. NOT compose service names: `portal:3002`
# resolves inside the Docker network and nowhere a participant can reach.
# For a real deployment use the host's public origin, e.g.
#   PUBLIC_PORTAL_URL=https://odyssey.example.org
PUBLIC_PORTAL_URL=http://localhost:3002
PUBLIC_LEVEL1_URL=http://localhost:3001

# --- Host port mapping -------------------------------------------------------
PORTAL_PORT=3002
LEVEL1_PORT=3001
# Host-side Postgres port, bound to loopback only. Change if 5432 is taken.
POSTGRES_PORT=5432

# --- ORION Level 3 bridge (optional) ----------------------------------------
# Leave BLANK to keep the bridge disabled; its endpoints then answer 503 rather
# than accepting unsigned events. Level 3's participant experience, target IP and
# sample report do NOT depend on these — they are portal-side configuration set
# by the Creator. These two are only for the external ORION discovery feed.
ODYSSEY_INTEGRATION_SECRET=
LEVEL3_CHALLENGE_URL=

# --- Login throttling: proxy trust ------------------------------------------
# Whether the Portal may believe X-Forwarded-For when rate limiting logins.
#
# LEAVE UNSET for this compose file. Both services publish their ports directly,
# so nothing in front rewrites the header. Turning it on without a proxy lets a
# client send a different X-Forwarded-For on every request, land in a fresh
# bucket each time, and walk past the limiter entirely.
#
# Set to 1 ONLY when a hop that APPENDS to X-Forwarded-For genuinely sits in
# front of the Portal - AWS ALB, nginx, Cloudflare. The Portal reads the
# RIGHTMOST entry, which is the one that hop wrote, so a forged prefix is inert.
#
#     TRUST_PROXY=1
#
# Unset is safe, just weaker: the Portal cannot tell callers apart, so the
# per-account limit (5 failures/minute) still applies in full while the
# cross-account ceiling is skipped rather than applied to everyone at once.
#
# NOTE: this is passed to the PORTAL only. Level 1 reads the LEFTMOST
# X-Forwarded-For entry, which behind an appending load balancer is the value
# the CLIENT sent - so enabling it there would hand attackers a bypass. Level 1
# deliberately has no passthrough in docker-compose.yml.
TRUST_PROXY=

# =============================================================================
# WHAT IS DELIBERATELY *NOT* HERE
# =============================================================================
# No NEXT_PUBLIC_* secret. Next inlines every NEXT_PUBLIC_* value into the
# browser bundle at build time, so anything placed there is published to every
# participant. The one NEXT_PUBLIC_ value the stack uses is Level 1's build arg
# for the Portal's public URL, which is not a secret and cannot be anything else.
#
# No DATABASE_URL. Both services build their own from POSTGRES_* above, so the
# password exists in exactly one place.
# =============================================================================
