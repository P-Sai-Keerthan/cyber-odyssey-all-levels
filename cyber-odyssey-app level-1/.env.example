# Standard PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cyber_odyssey"

# Used to sign session cookies (HMAC-SHA256)
SESSION_SECRET="change-this-to-a-secure-random-string"

# Dedicated Level 1 Admin password
ADMIN_PASSWORD="change-this-before-the-event"

# --- Reverse-proxy trust (attempt throttling) --------------------------------
# LEAVE UNSET unless Level 1 genuinely runs behind a reverse proxy that SETS
# X-Forwarded-For itself.
#
# The login throttler keys on the client address. `X-Forwarded-For` is supplied
# by whoever sent the request, so trusting it when there is no proxy lets an
# attacker send a different value each time, land in a fresh bucket each time,
# and never be throttled. That was demonstrated against this application:
# eleven wrong passwords from one address were throttled at the eleventh, while
# fourteen with a rotating header were never throttled at all.
#
# Unset (the default) means the socket address is used, which cannot be forged
# over TCP. Set to 1 ONLY when a proxy in front overwrites the header.
# TRUST_PROXY=1

# --- Throttler memory bounds (optional) --------------------------------------
# Defaults are fine for a 60-crew event. Counters are per-process and reset on
# restart; they do NOT span replicas. See lib/rateLimitStore.js.
# RATE_LIMIT_MAX_KEYS=20000
# RATE_LIMIT_SWEEP_MS=60000

# ---------------------------------------------------------------------------
# Cyber Odyssey Portal integration bridge
# ---------------------------------------------------------------------------
# Origin of the Cyber Odyssey Portal. No trailing slash, no path.
#
# The Portal listens on 3002 (see its package.json: `next dev -p 3002` /
# `next start -p 3002`). This template said 3000, which is nothing in this
# system — a fresh checkout copying it verbatim got a Portal bridge that could
# never redeem a ticket, and the failure surfaced as "entry=error" with no clue
# why. Level 1 itself is 3001.
PORTAL_BASE_URL="http://localhost:3002"

# Shared HMAC-SHA256 secret. MUST match ODYSSEY_LEVEL1_SECRET on the Portal.
#
# Deliberately separate from any ORION secret: Level 1 and ORION are both
# applications participants attack, and a compromise of one must not confer the
# ability to sign events for the other.
#
# Leave blank to disable the bridge. Score events still queue safely in
# integration_outbox and deliver once it is set — nothing is lost meanwhile.
# There is no default: a default here would be a public secret, and a public
# secret on this bridge means anyone can award points to any squad.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ODYSSEY_LEVEL1_SECRET=""

# How long to wait on the Portal before treating a call as failed (ms).
# PORTAL_TIMEOUT_MS="8000"

# Portal origin as the BROWSER sees it, for "Return to Portal" links.
# Normally the same address as PORTAL_BASE_URL above. It is a separate variable
# because PORTAL_BASE_URL is used for server-to-server calls and is deliberately
# not exposed to the browser; Next.js only inlines NEXT_PUBLIC_* into client
# bundles. Changing this requires a rebuild, as with any NEXT_PUBLIC_ value.
NEXT_PUBLIC_PORTAL_BASE_URL="http://localhost:3002"
