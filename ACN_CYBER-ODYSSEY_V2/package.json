{
  "name": "cyber-odyssey-v2",
  "version": "0.1.0",
  "private": true,
  "description": "ACN Cyber Odyssey V2 - TRACE Event Portal",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "posttest": "tsx prisma/seed.ts",
    "test:watch": "vitest",
    "check:no-cdn": "node scripts/check-no-cdn.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run check:no-cdn",
    "db:doctor": "tsx -r ./scripts/shim-server-only.cjs scripts/db-doctor.ts",
    "db:pragmas": "tsx scripts/apply-db-pragmas.ts",
    "db:migrate": "prisma migrate deploy",
    "seed:event-fixture": "tsx scripts/seed-event-fixture.ts",
    "load:test": "tsx scripts/load-test.ts",
    "load:scenarios": "tsx scripts/load-scenarios.ts",
    "bench:password": "tsx scripts/bench-password.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:migrate-validate": "tsx scripts/db-migrate-validate.ts",
    "seed:level3-bugs": "tsx scripts/seed-level3-bugs.ts",
    "seed:level1": "tsx scripts/seed-level1-challenges.ts",
    "backfill:team-refs": "tsx scripts/backfill-team-external-refs.ts",
    "seed:local-test": "tsx -r ./scripts/shim-server-only.cjs scripts/seed-local-testing.ts",
    "test:local-setup": "tsx -r ./scripts/shim-server-only.cjs scripts/verify-local-testing.ts",
    "load:http": "tsx -r ./scripts/shim-server-only.cjs scripts/load-http.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
