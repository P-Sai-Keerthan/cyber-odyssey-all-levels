# =============================================================================
# ACN CYBER ODYSSEY V2 — ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to `.env` and replace every placeholder with a real value.
# NEVER commit a populated `.env` — it is git-ignored for exactly this reason.
# NEVER put a real password or secret in THIS file; it IS committed.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------------------------------------
# The portal runs on PostgreSQL. It previously used SQLite, which admits exactly
# ONE writer at a time: with 100 squads submitting and being scored inside the
# same few minutes, every interactive transaction serialises behind a single
# lock. WAL mode raised that ceiling but could not remove it.
#
# The pool parameters are not decoration. `connection_limit` bounds how many
# connections this process opens; `pool_timeout` is how long a request waits for
# one before failing rather than hanging. Size the limit against the server's
# max_connections divided by the number of app instances.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/odyssey_portal?schema=public&connection_limit=20&pool_timeout=20&connect_timeout=10"

# TESTS USE A SEPARATE DATABASE. Several suites truncate whole tables as part of
# their setup, so they must never be pointed at a database an event is running
# on. Put this in `.env.test` (git-ignored), NOT here:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/odyssey_portal_test?schema=public"

# -----------------------------------------------------------------------------
# CREATOR BOOTSTRAP ACCOUNT
# -----------------------------------------------------------------------------
# Used ONLY by `npm run db:seed` to create/rotate the single CREATOR account.
# Both variables are REQUIRED — the seed script refuses to run without them.
# Generate a strong password (>= 16 chars) and store it in your secret manager.
# The seed reads THREE variables per creator. A missing username is not fatal —
# it is derived from the email — but naming it here keeps `.env` and the seed in
# step, which they were not: the live `.env` carries CREATOR_USERNAME and a full
# second creator that this template never mentioned.
CREATOR_EMAIL="creator@example.org"
CREATOR_PASSWORD="replace-me-with-a-strong-unique-password"
CREATOR_USERNAME="creator"

# OPTIONAL second creator account. Seeded only when all three are present.
# CREATOR_2_EMAIL="creator2@example.org"
# CREATOR_2_PASSWORD="replace-me-with-a-different-strong-password"
# CREATOR_2_USERNAME="creator2"

# ---------------------------------------------------------------------------
# ORION Level 3 integration bridge
# ---------------------------------------------------------------------------
# Shared HMAC-SHA256 secret. MUST match ORION_INTEGRATION_SECRET on the ORION
# challenge host. Leave blank to disable the bridge — the ingest endpoint then
# returns 503 rather than accepting unsigned events.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ODYSSEY_INTEGRATION_SECRET=

# Public URL of the ORION Level 3 challenge application shown to participants.
LEVEL3_CHALLENGE_URL=http://100.59.255.15:5000/participant-login

# ---------------------------------------------------------------------------
# Level 1 integration bridge
# ---------------------------------------------------------------------------
# Shared HMAC-SHA256 secret for the Level 1 bridge. MUST match
# ODYSSEY_LEVEL1_SECRET on the Level 1 application host.
#
# DELIBERATELY SEPARATE from ODYSSEY_INTEGRATION_SECRET. Level 1 and ORION are
# both applications participants actively attack; a compromise of one must not
# confer the ability to sign events for the other.
#
# Leave blank to disable the bridge — the endpoints then return 503 rather than
# accepting unsigned events. There is no default: a default secret on these
# endpoints would let anyone award points to any squad.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ODYSSEY_LEVEL1_SECRET=

# Origin of the Level 1 challenge application, with no trailing slash and no path.
# Participants are sent to <this>/api/enter?ticket=... when they click Enter Level 1.
# No default: unset disables the entry control rather than sending squads somewhere
# that is probably wrong.
# LEVEL1_CHALLENGE_URL=http://localhost:3001

# --- Login throttling ---------------------------------------------------------
# Only FAILED sign-ins count; a correct password clears the counter, so these
# never slow down a participant who types it right.
#
# Per (address + account). This is the real guessing limit. It is NAT-safe
# because the account is part of the key: one squad fat-fingering its password
# cannot affect anybody else at the same venue.
# PORTAL_LOGIN_MAX_PER_IDENTIFIER=5      # failures per minute
#
# Per address, across every account - a BACKSTOP against one machine spraying
# many accounts. It must be sized for the WHOLE VENUE, not one person: ~300
# participants share one public address, and 300 x 3 mistypes is 900 failures
# in a 15-minute window at event start. Do NOT lower this to a per-user figure.
# PORTAL_LOGIN_MAX_PER_ADDRESS=2000
#
# Hard cap on tracked keys per bucket, so an unauthenticated caller cannot grow
# the heap. Eviction only ever forgives a counter - it never invents a lockout.
# PORTAL_LOGIN_MAX_KEYS=20000
#
# TRUST_PROXY - SET THIS IN PRODUCTION.
#
# Set to 1 when the Portal sits behind a load balancer or reverse proxy that
# appends to X-Forwarded-For (AWS ALB does). The rightmost entry is read, which
# is the one the trusted hop wrote - a client-forged prefix is inert.
#
# Left unset behind a load balancer, no per-client signal exists at all: every
# caller resolves to "unknown". The per-account limit above still works (the
# account is part of that key), but the cross-account ceiling is DISABLED rather
# than applied globally - a shared bucket could only ever take the whole venue
# down at once. So an unset TRUST_PROXY is safe, just weaker.
# TRUST_PROXY=1
